# TheMealDB API Key
# TheMealDB provides a free public test key ("1") that works out of the box with no signup needed.
# For premium supporters on Patreon with multi-ingredient filter or full access, you can supply your personal key here:
VITE_THEMEALDB_API_KEY="1"

# API Base URL (defaults to https://www.themealdb.com/api/json/v1/)
VITE_API_BASE_URL="https://www.themealdb.com/api/json/v1"

# GEMINI_API_KEY: Optional - for AI Studio environment
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

